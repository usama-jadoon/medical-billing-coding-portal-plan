# Application
APP_ENV=development
APP_NAME="Medical Billing & Coding Portal"
DEBUG=true
PORT=8000
SECRET_KEY=change-this-in-production-use-a-secure-random-32-byte-hex-string

# Database
# For PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/medical_coding
# For SQLite local fallback: sqlite+aiosqlite:///./medical_coding.db
DATABASE_URL=sqlite+aiosqlite:///./medical_coding.db

# Storage (S3 / MinIO or Local)
# STORAGE_PROVIDER: "local" or "s3"
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./local_storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=medical-documents
S3_REGION=us-east-1

# Queue & Worker (Redis or in-process sync)
# QUEUE_BACKEND: "redis" or "sync"
QUEUE_BACKEND=sync
REDIS_URL=redis://localhost:6379/0

# AI Provider Abstraction
# LLM_PROVIDER: "mock", "ollama", or "openai"
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=llama3.2

# OCR Provider Abstraction
# OCR_PROVIDER: "local" or "mock"
OCR_PROVIDER=local

# Security & Sessions
ACCESS_TOKEN_EXPIRE_MINUTES=30
STEP_UP_MAX_AGE_SECONDS=300
# Set a named owner to disable access by legacy demo users.
OWNER_EMAIL=
# Optional base32 TOTP secret provisioned in your authenticator (store securely).
OWNER_TOTP_SECRET=
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Daily policy and licensed catalog sync (disabled until adapters are configured)
POLICY_SYNC_ENABLED=false
MCA_CODE_API_PROVIDER=findacode
MCA_CODE_API_BASE_URL=https://api.findacode.com/v1
MCA_CODE_API_VALIDITY_URL=
MCA_CODE_API_CATALOG_URL=
MCA_CODE_API_KEY=
MCA_CODE_API_SECRET=
CMS_COVERAGE_API_BASE_URL=https://api.coverage.cms.gov
DEFAULT_MAC_JURISDICTION=JH
DEFAULT_DME_MAC_JURISDICTION=JC
DEFAULT_STATE_CODE=TX
# Optional numeric CMS IDs; without them, reports are nationwide.
# CMS_CONTRACTOR_ID=
# CMS_STATE_ID=
POLICY_SYNC_CRON=0 0 * * *
POLICY_CACHE_TTL_HOURS=24
PAYER_POLICY_FEEDS_JSON=[]
